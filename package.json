{
  "name": "acoustic-ray-tracing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cd core && PATH=\"$HOME/.cargo/bin:$PATH\" RUSTFLAGS=\"-C target-feature=+simd128\" cargo build --release --target wasm32-unknown-unknown && mkdir -p ../src/wasm && cp target/wasm32-unknown-unknown/release/core_acoustics.wasm ../src/wasm/core.wasm",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:rust": "cd core && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --release",
    "test:all": "npm run test:rust && npm test",
    "validate:bras": "vitest run src/validation/bras.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "omnitone": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
